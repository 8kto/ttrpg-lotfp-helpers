{
  "name": "ttrpg-lotfp-helpers",
  "version": "0.4.8",
  "license": "CC-BY-NC-4.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:coverage": "jest --collectCoverage",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e": "playwright test --project chrome --project mobileChrome",
    "test:e2e:update": "yarn test:e2e:all -u",
    "format": "prettier . --check --experimental-cli",
    "format:fix": "yarn lint -- --fix && prettier --experimental-cli --write .",
    "weok": "yarn tsc && yarn lint && yarn format && yarn test && yarn check:context && echo WE OK",
    "check:context": "node scripts/check_context.mjs",
    "todos": "egrep --color=always -i '(TODO|FIXME)' -r src/",
    "update-readme-stats": "./scripts/update_readme_stats.sh README.md",
    "translations:extract": "lingui extract --clean",
    "preversion": "[ \"$(git branch --show-current)\" = main ] || (echo 'Error: You can only bump versions on the main branch!' >&2; exit 1)",
    "bump": "yarn version --patch"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@hookstate/core": "^4.0.1",
    "@hookstate/localstored": "^4.0.2",
    "@lingui/core": "^4.5.0",
    "@lingui/react": "^4.5.0",
    "@vercel/analytics": "^1.2.2",
    "@vercel/speed-insights": "^1.0.10",
    "classnames": "^2.3.2",
    "formik": "^2.4.5",
    "lz-string": "^1.5.0",
    "next": "14.2.35",
    "next-pwa": "^5.6.0",
    "react": "^18",
    "react-dom": "^18",
    "rfdc": "^1.3.0",
    "throttle-debounce": "^5.0.0",
    "yup": "^1.3.2"
  },
  "devDependencies": {
    "@lingui/cli": "^4.5.0",
    "@lingui/format-po": "4.5.0",
    "@lingui/loader": "^4.5.0",
    "@lingui/macro": "^4.5.0",
    "@lingui/swc-plugin": "4.0.9",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.0",
    "@types/jest": "^29.5.8",
    "@types/node": "^26",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/throttle-debounce": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.5.2",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-lingui": "^0.2.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-sort-destructure-keys": "^1.5.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unused-imports": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
